# Local development only. Change credentials and JWT_SECRET before deployment.
POSTGRES_DB=mini_lms
POSTGRES_USER=minilms
POSTGRES_PASSWORD=minilms_local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://minilms:minilms_local_dev_password@127.0.0.1:5432/mini_lms
DATABASE_SCHEMA=public
JWT_SECRET=dev-only-secret-at-least-32-characters-long!!
BCRYPT_ROUNDS=12
LOCAL_EMAIL_ENABLED=1

# Optional SMTP delivery. Local development saves reset links to instance/mailbox.
# Leave SMTP disabled for local email simulation; no mail credentials required.
PUBLIC_BASE_URL=http://127.0.0.1:5000
RESET_TOKEN_TTL_SECONDS=900
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT_SECONDS=10
